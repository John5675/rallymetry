{
  "planVersion": "1",
  "pipelineVersion": "release-0.1-render-workflow-v2",
  "stages": [
    {
      "stage": "PLAYER_PROCESSING",
      "progress": 0.15,
      "argv": [
        "detect-people",
        "{source}",
        "--calibration",
        "{input}/calibration.json",
        "--output-dir",
        "{workspace}/person-detection"
      ],
      "cleanupPaths": ["person-detection/annotated.mp4"]
    },
    {
      "stage": "PLAYER_PROCESSING",
      "progress": 0.17,
      "argv": [
        "track-players",
        "{source}",
        "--calibration",
        "{input}/calibration.json",
        "--detections",
        "{workspace}/person-detection/detections.json",
        "--assignments",
        "{input}/player-assignments.json",
        "--portable-profile",
        "--output-dir",
        "{workspace}/player-tracking"
      ]
    },
    {
      "stage": "PLAYER_PROCESSING",
      "progress": 0.20,
      "argv": [
        "analyze-players",
        "{source}",
        "--calibration",
        "{input}/calibration.json",
        "--tracks",
        "{workspace}/player-tracking/tracks.json",
        "--output-dir",
        "{workspace}/player-analysis"
      ],
      "cleanupPaths": ["player-analysis/annotated.mp4"]
    },
    {
      "stage": "BALL_PROCESSING",
      "progress": 0.30,
      "argv": [
        "ball",
        "detect",
        "{source}",
        "--config",
        "{input}/ball-experiment.json",
        "--weights",
        "{input}/ball-weights.pt",
        "--device",
        "{device}",
        "--strategy",
        "court-roi-1920",
        "--calibration",
        "{input}/calibration.json",
        "--output-dir",
        "{workspace}/ball-detection"
      ],
      "cleanupPaths": ["ball-detection/annotated.mp4"]
    },
    {
      "stage": "BALL_PROCESSING",
      "progress": 0.40,
      "argv": [
        "track-ball",
        "{source}",
        "--detections",
        "{workspace}/ball-detection/detections.json",
        "--calibration",
        "{input}/calibration.json",
        "--output-dir",
        "{workspace}/ball-tracking"
      ]
    },
    {
      "stage": "AUDIO_PROCESSING",
      "progress": 0.55,
      "argv": [
        "analyze-audio",
        "{source}",
        "--output-dir",
        "{workspace}/audio-analysis"
      ]
    },
    {
      "stage": "RALLY_PROCESSING",
      "progress": 0.65,
      "argv": [
        "segment-rallies",
        "{source}",
        "--ball-tracks",
        "{workspace}/ball-tracking/ball_tracks.json",
        "--player-tracks",
        "{workspace}/player-tracking/tracks.json",
        "--audio-events",
        "{workspace}/audio-analysis/audio-events.json",
        "--output-dir",
        "{workspace}/rallies"
      ]
    },
    {
      "stage": "BOUNCE_PROCESSING",
      "progress": 0.70,
      "argv": [
        "detect-bounces",
        "{source}",
        "--ball-tracks",
        "{workspace}/ball-tracking/ball_tracks.json",
        "--calibration",
        "{input}/calibration.json",
        "--rallies",
        "{workspace}/rallies/rallies.json",
        "--audio-events",
        "{workspace}/audio-analysis/audio-events.json",
        "--output-dir",
        "{workspace}/bounces"
      ],
      "cleanupPaths": ["bounces/bounce-debug.mp4"]
    },
    {
      "stage": "CONTACT_PROCESSING",
      "progress": 0.75,
      "argv": [
        "detect-contacts",
        "{source}",
        "--ball-tracks",
        "{workspace}/ball-tracking/ball_tracks.json",
        "--player-tracks",
        "{workspace}/player-tracking/tracks.json",
        "--rallies",
        "{workspace}/rallies/rallies.json",
        "--bounces",
        "{workspace}/bounces/bounces.json",
        "--audio-events",
        "{workspace}/audio-analysis/audio-events.json",
        "--output-dir",
        "{workspace}/contacts"
      ],
      "cleanupPaths": ["contacts/contact-debug.mp4"]
    },
    {
      "stage": "HITTER_PROCESSING",
      "progress": 0.80,
      "argv": [
        "identify-hitters",
        "{source}",
        "--contacts",
        "{workspace}/contacts/contacts.json",
        "--player-tracks",
        "{workspace}/player-tracking/tracks.json",
        "--output-dir",
        "{workspace}/hitters"
      ],
      "cleanupPaths": ["hitters/hitter-debug.mp4"]
    },
    {
      "stage": "SHOT_PROCESSING",
      "progress": 0.85,
      "argv": [
        "reconstruct-shots",
        "{source}",
        "--ball-tracks",
        "{workspace}/ball-tracking/ball_tracks.json",
        "--rallies",
        "{workspace}/rallies/rallies.json",
        "--contacts",
        "{workspace}/contacts/contacts.json",
        "--bounces",
        "{workspace}/bounces/bounces.json",
        "--hitters",
        "{workspace}/hitters/hitters.json",
        "--player-tracks",
        "{workspace}/player-tracking/tracks.json",
        "--output-dir",
        "{workspace}/shots"
      ]
    },
    {
      "stage": "ANALYTICS",
      "progress": 0.90,
      "argv": [
        "analyze-match",
        "{source}",
        "--rallies",
        "{workspace}/rallies/rallies.json",
        "--shots",
        "{workspace}/shots/shots.json",
        "--player-positions",
        "{workspace}/player-analysis/player_positions.json",
        "--output",
        "{workspace}/analytics/match-analytics.json"
      ]
    }
  ],
  "structuredResults": [
    {
      "collection": "rallies",
      "path": "rallies/rallies.json",
      "recordsKey": "rallies",
      "idField": "rallyId",
      "timestampField": "startTimestamp",
      "confidenceField": "confidence"
    },
    {
      "collection": "bounces",
      "path": "bounces/bounces.json",
      "recordsKey": "bounceCandidates",
      "idField": "bounceId",
      "timestampField": "timestamp",
      "confidenceField": "fusedConfidence"
    },
    {
      "collection": "contacts",
      "path": "contacts/contacts.json",
      "recordsKey": "contactCandidates",
      "idField": "contactId",
      "timestampField": "timestamp",
      "confidenceField": "fusedConfidence"
    },
    {
      "collection": "shots",
      "path": "shots/shots.json",
      "recordsKey": "shots",
      "idField": "shotId",
      "timestampField": "contactTimestamp",
      "confidenceField": "confidence"
    },
    {
      "collection": "analytics",
      "path": "analytics/match-analytics.json"
    }
  ],
  "artifacts": [
    {
      "path": "player-tracking/annotated.mp4",
