# Copy to .env.worker and keep it private (chmod 600 .env.worker).
MONGODB_URL=
MONGODB_DATABASE=rallymetry

# Hosted artifact publication. Both values stay on the worker, never in VITE_*.
PICKLEBALL_VISION_ARTIFACT_BACKEND=vercel_blob
BLOB_READ_WRITE_TOKEN=
PUBLIC_BLOB_READ_WRITE_TOKEN=

# Existing inspectable pipeline plan and local compute settings.
PIPELINE_CONFIG=../../docs/examples/render-workflow-pipeline-plan.json
MODEL_DEVICE=mps
WORKFLOW_TEMP_DIR=../../output/worker-tmp
YOUTUBE_MAX_DURATION_SECONDS=7200
YOUTUBE_MAX_BYTES=4000000000

# One match at a time with a bounded recoverable lease.
WORKER_ID=johns-mac
WORKER_POLL_SECONDS=10
WORKER_HEARTBEAT_SECONDS=30
WORKER_LEASE_SECONDS=180
WORKER_MAX_ATTEMPTS=2
