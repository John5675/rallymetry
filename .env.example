# Optional hosted structured persistence. Keep the real value in your shell or
# deployment secret store; never commit it.
MONGODB_URL=
MONGODB_DATABASE=pickleball_vision

# Comma-separated browser origins allowed to call the FastAPI application.
CORS_ORIGINS=http://localhost:5173,https://rallymetry.vercel.app,https://matches.example.com

# Local artifacts are the credential-free development default.
PICKLEBALL_VISION_ARTIFACT_BACKEND=local
PICKLEBALL_VISION_LOCAL_ARTIFACT_ROOT=output/artifacts

# Required only when PICKLEBALL_VISION_ARTIFACT_BACKEND=vercel_blob.
BLOB_READ_WRITE_TOKEN=
# Separate public store used only for explicit PUBLIC + VIEWABLE_MEDIA artifacts.
PUBLIC_BLOB_READ_WRITE_TOKEN=

# FastAPI-only Render trigger. Never expose either value through VITE_*.
RENDER_API_KEY=
RENDER_WORKFLOW_TASK=rallymetry-analysis/analyze_match
# Existing configured match whose private calibration/assignment/model setup is
# cloned by reference for one-click YouTube submissions.
DEFAULT_ANALYSIS_PROFILE_MATCH_ID=

# On-demand Render Workflow task configuration.
PIPELINE_CONFIG=../../docs/examples/render-workflow-pipeline-plan.json
MODEL_DEVICE=cpu
WORKFLOW_TEMP_DIR=/tmp/rallymetry
RENDER_WORKFLOW_PLAN=pro
RENDER_WORKFLOW_TIMEOUT_SECONDS=21600
YOUTUBE_MAX_DURATION_SECONDS=7200
YOUTUBE_MAX_BYTES=4000000000
# Private HTTP endpoint for the server-side yt-dlp PO-token provider. This lets
# external users submit public or unlisted links without sharing account cookies.
YOUTUBE_POT_PROVIDER_URL=
# Optional authenticated residential egress for cloud IP ranges blocked by YouTube.
# Keep this server-side secret; never expose it through VITE_* variables.
YOUTUBE_PROXY_URL=
